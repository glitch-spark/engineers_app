# Copy to .env.development / .env.production. Vite exposes only VITE_* vars to the browser; never put secrets here.
# Backend API origin, no trailing slash. Blank in dev = http://localhost:8080.
VITE_API_BASE_URL=http://localhost:8080
# IANA timezone for dates shown in the app. Blank = Asia/Tokyo.
VITE_APP_TIMEZONE=America/New_York
